# Copiar a .env para ajustar las claves locales. No usar estos valores por defecto en AWS.
RABBITMQ_USERNAME=cineapp
RABBITMQ_PASSWORD=cinepass-local
RABBITMQ_ERLANG_COOKIE=CineNocturnoLocalCookie2026
RABBIT_ADMIN_API_KEY=local-admin-key-change-me

# Para APP_AUTH_MODE=firebase, indicar la ruta local al JSON de servicio, fuera del repositorio.
# FIREBASE_CREDENTIALS_PATH=C:/ruta/segura/mi-proyecto-firebase-adminsdk.json

# Para AWS RDS activar profile aws y llenar estas variables como secretos de entorno:
# DB_HOST=endpoint-rds
# DB_PORT=3306
# DB_NAME=cinedb
# DB_USERNAME=usuario_aplicacion
# DB_PASSWORD=secreto
