<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.cine.benja</groupId>
    <artifactId>cine-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>cine-backend</name>
    <description>Backend Spring Boot del proyecto EP1 DSY1107 - Cine</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Para exponer la API REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Para las entidades, repositorios y acceso a datos -->
        <!-- YA NO VAN ACA: el BFF no toca la base de datos directamente,
             eso ahora es responsabilidad exclusiva de cine-core.
             (data-jpa, h2 y mysql-connector se movieron a cine-core/pom.xml) -->

        <!-- Validaciones simples con anotaciones (@NotBlank, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Seguridad base de Spring (SecurityFilterChain, SecurityContext, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- SDK de administracion de Firebase: verifica los ID Tokens que emite
             Firebase Authentication (reemplaza al starter de OAuth2 Resource Server de Azure) -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.3.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Permite simular un usuario autenticado en los tests sin llamar a Firebase de verdad -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
